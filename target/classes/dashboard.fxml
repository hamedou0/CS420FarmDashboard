<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TreeItem?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.zac.farmdashboard.DashboardController">

    <left>
        <VBox spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" left="10" right="10" bottom="10"/>
            </padding>

            <Label style="-fx-font-weight: bold;" text="1. Items / Item Containers" />

            <HBox spacing="10">

                <TreeView fx:id="treeView" prefHeight="250" prefWidth="180">
                    <root>
                        <TreeItem expanded="true" value="Root"/>
                    </root>
                </TreeView>

                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold; -fx-background-color: lightgray; -fx-padding: 5;"
                           text="Commands on Items"/>
                    <Button maxWidth="Infinity" text="Rename" onAction="#handleRenameItem"/>
                    <Button maxWidth="Infinity" text="Change Location" onAction="#handleChangeItemLocation"/>
                    <Button maxWidth="Infinity" text="Change Price" onAction="#handleChangeItemPrice"/>
                    <Button maxWidth="Infinity" text="Change Dimensions" onAction="#handleChangeItemDimensions"/>
                    <Button maxWidth="Infinity" text="Delete" onAction="#handleDeleteItem"/>
                </VBox>

            </HBox>

            <VBox spacing="5">
                <Label style="-fx-font-weight: bold; -fx-background-color: lightgray; -fx-padding: 5;"
                       text="Commands on Item Containers"/>

                <Button maxWidth="Infinity" text="Rename" onAction="#handleRenameContainer"/>
                <Button maxWidth="Infinity" text="Change Location" onAction="#handleChangeContainerLocation"/>
                <Button maxWidth="Infinity" text="Change Price" onAction="#handleChangeContainerPrice"/>
                <Button maxWidth="Infinity" text="Change Dimensions" onAction="#handleChangeContainerDimensions"/>
                <Button maxWidth="Infinity" text="Add Item" onAction="#handleAddItem"/>
                <Button maxWidth="Infinity" text="Add Item-Container" onAction="#handleAddItemContainer"/>
                <Button maxWidth="Infinity" text="Delete" onAction="#handleDeleteContainer"/>
            </VBox>

            <Separator/>

            <VBox spacing="5">
                <Label style="-fx-font-weight: bold;" text="3. Drone Actions"/>

                <Button maxWidth="Infinity" text="Visit Item / Container" onAction="#handleVisitContainer"/>
                <Button maxWidth="Infinity" text="Scan Farm" onAction="#handleScanFarm"/>

                <Separator/>

                <Button maxWidth="Infinity" text="Soil Moisture" onAction="#handleSoilMoisture"/>
                <Button maxWidth="Infinity" text="Crop Growth" onAction="#handleCropGrowth"/>
                <Button maxWidth="Infinity" text="Weather" onAction="#handleWeather"/>
                <Button maxWidth="Infinity" text="Livestock Monitoring" onAction="#handleLivestock"/>
                <Button maxWidth="Infinity" text="Harvest Readiness" onAction="#handleHarvest"/>
                <Button maxWidth="Infinity" text="Pest Detection" onAction="#handlePestDetection"/>
                <Button maxWidth="Infinity" text="Nutrient Levels" onAction="#handleNutrientLevels"/>
                <Button maxWidth="Infinity" text="Equipment Tracking" onAction="#handleEquipmentTracking"/>
            </VBox>

        </VBox>
    </left>
    <center>
        <VBox spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" left="10" right="10" bottom="10"/>
            </padding>

            <Label style="-fx-font-weight: bold; -fx-font-size: 18;"
                   text="2. Visualization (800 x 600)"/>

            <Pane fx:id="visualizationPane"
                  prefWidth="800"
                  prefHeight="600"
                  style="-fx-border-color: black; -fx-background-color: white;"/>
        </VBox>
    </center>

</BorderPane>
